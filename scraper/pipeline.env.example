# IBM Cloud Tekton Pipeline credentials
IBM_CLOUD_API_KEY=your-api-key-here
PIPELINE_ID=your-pipeline-uuid-here
REGION=us-south
TRIGGER_NAME=pr-trigger

# Optional: GitHub Enterprise token for merge-commit rerun detection
GITHUB_TOKEN=

# Optional: Override FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=tekton-dashboard

# Optional: Path to downloaded logs for error/stage analysis.
# Defaults to a "logs/" directory next to this file when left blank.
# LOGS_BASE_DIR=/absolute/path/to/logs
