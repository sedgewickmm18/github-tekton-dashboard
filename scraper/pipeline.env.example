# IBM Cloud Tekton Pipeline Configuration
# Copy this file to pipeline.env and fill in your values.

# Your IBM Cloud API key
IBM_CLOUD_API_KEY=

# Tekton pipeline UUID (from the pipeline URL in IBM Cloud)
PIPELINE_ID=

# IBM Cloud region, e.g. us-south, eu-gb
REGION=us-south

# Trigger name as shown in the Tekton pipeline triggers list
TRIGGER_NAME=pr-trigger

# GitHub personal access token (optional — enables merge-commit rerun detection)
# Accepts GITHUB_TOKEN, REPO_GITHUB_TOKEN, GH_TOKEN, or GITHUB_PAT
# Note: For GitHub Actions secrets, use REPO_GITHUB_TOKEN or GH_TOKEN (GITHUB_* prefix is reserved by GitHub)
REPO_GITHUB_TOKEN=
# GITHUB_TOKEN=

# Full URL to the Tekton pipeline in the IBM Cloud console (optional — shown as
# a quick link in the dashboard Settings tab)
PIPELINE_URL=

# Full URL to the GitHub repository (optional — shown as a quick link in the
# dashboard Settings tab)
GITHUB_REPO_URL=
